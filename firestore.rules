rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Claims are supported when present. The canonical usuarios/{uid} record
    // is the fallback established by the migration, so existing accounts do
    // not require a forced token refresh or an Admin SDK claim backfill.
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.keys().hasAny(['admin', 'perfil']) && (
          request.auth.token.admin == true ||
          request.auth.token.perfil in ['ADMIN', 'ADMINISTRADOR']
        )) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['ADMIN', 'ADMINISTRADOR', 'Administrador'])
      );
    }

    function isSocio() {
      return signedIn() && (
        (request.auth.token.keys().hasAll(['perfil', 'socioId']) &&
          request.auth.token.perfil == 'SOCIO' &&
          request.auth.token.socioId is string &&
          request.auth.token.socioId != '') ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'SOCIO' &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.socioId is string &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.socioId != '')
      );
    }

    function ownSocioDocument() {
      return isSocio() && resource.data.socioId == socioIdAutenticado();
    }

    function ownSocioCreate() {
      return isSocio() && request.resource.data.socioId == socioIdAutenticado();
    }

    function socioIdAutenticado() {
      return request.auth.token.keys().hasAll(['perfil', 'socioId']) &&
          request.auth.token.perfil == 'SOCIO'
        ? request.auth.token.socioId
        : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.socioId;
    }

    function ownUserByUid(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownUserByEmail() {
      return signedIn() && resource.data.email == request.auth.token.email;
    }

    // The client is first marked EXCLUINDO by the cascading deletion flow.
    // This closes the race window: after that mark no new sale, installment,
    // contract or financial record can be attached before the cleanup batch.
    function clienteAtivo(clienteId) {
      return clienteId is string &&
        exists(/databases/$(database)/documents/clientes/$(clienteId)) &&
        (!get(/databases/$(database)/documents/clientes/$(clienteId)).data.keys().hasAny(['status']) ||
          get(/databases/$(database)/documents/clientes/$(clienteId)).data.status == 'ATIVO');
    }

    function vendaDoClienteExiste(vendaId, clienteId) {
      return vendaId is string && clienteId is string &&
        exists(/databases/$(database)/documents/vendas/$(vendaId)) &&
        get(/databases/$(database)/documents/vendas/$(vendaId)).data.clienteId == clienteId;
    }

    // Authentication profile. Existing random document IDs remain compatible
    // through the email query; migrating to usuarios/{uid} is recommended.
    match /usuarios/{userId} {
      allow get: if isAdmin() || ownUserByUid(userId) || ownUserByEmail();
      allow list: if isAdmin() || ownUserByEmail();
      allow create, update, delete: if isAdmin();
    }

    // Collections containing socioId. A SOCIO must query these collections with
    // where("socioId", "==", request.auth.token.socioId) to satisfy rules.
    match /clientes/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if isAdmin() || ownSocioCreate();
      allow update: if isAdmin() || ownSocioDocument();
      // A hard delete cascades through financial collections, including
      // administrator-only cobrança records, and must therefore be admin-only.
      allow delete: if isAdmin();
    }

    match /estoque/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if isAdmin() || ownSocioCreate();
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    match /vendas/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if (isAdmin() || ownSocioCreate()) && clienteAtivo(request.resource.data.clienteId);
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    match /parcelas/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if (isAdmin() || ownSocioCreate()) &&
        clienteAtivo(request.resource.data.clienteId) &&
        vendaDoClienteExiste(request.resource.data.vendaId, request.resource.data.clienteId);
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    match /repasses/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if (isAdmin() || ownSocioCreate()) &&
        vendaDoClienteExiste(request.resource.data.idVenda, get(/databases/$(database)/documents/vendas/$(request.resource.data.idVenda)).data.clienteId);
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    match /contratos/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if (isAdmin() || ownSocioCreate()) && clienteAtivo(request.resource.data.clienteId);
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    match /movimentacoes/{id} {
      allow read: if isAdmin() || ownSocioDocument();
      allow create: if (isAdmin() || ownSocioCreate()) &&
        (!request.resource.data.keys().hasAny(['clienteId']) || request.resource.data.clienteId == '' || clienteAtivo(request.resource.data.clienteId));
      allow update, delete: if isAdmin() || ownSocioDocument();
    }

    // These collections currently have no reliable socioId field and therefore
    // remain administrator-only until their data model is adapted.
    match /socios/{id} {
      allow read, write: if isAdmin();
    }

    match /despesas/{id} {
      allow read, write: if isAdmin();
    }

    match /cobrancas/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() && clienteAtivo(request.resource.data.clienteId);
    }

    match /cobrancaLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /configuracoes/{id} {
      allow read, write: if isAdmin();
    }

    match /configuracoesCobranca/{id} {
      allow read, write: if isAdmin();
    }

    // Deny every collection not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
