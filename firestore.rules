rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Prefer the Firebase Auth custom claim. The document fallback becomes
    // available after the usuarios/{uid} migration described in the report.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.perfil in ['ADMIN', 'ADMINISTRADOR'] ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['ADMIN', 'ADMINISTRADOR']
        )
      );
    }

    function isOwnUserByUid(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Temporary compatibility for the current collection, whose documents
    // were created with random IDs and are looked up by email by the app.
    function isOwnUserByEmail() {
      return signedIn() && resource.data.email == request.auth.token.email;
    }

    match /usuarios/{userId} {
      allow get: if isAdmin() || isOwnUserByUid(userId) || isOwnUserByEmail();
      allow list: if isAdmin() || isOwnUserByEmail();
      allow create, update, delete: if isAdmin();
    }

    // Existing production rule preserved verbatim. It currently grants the
    // same temporary access to every collection until its published expiry.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 8, 5);
    }
  }
}
